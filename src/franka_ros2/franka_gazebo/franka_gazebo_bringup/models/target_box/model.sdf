<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="target_box">
    <static>false</static>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>false</publish_link_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <update_frequency>30</update_frequency>
    </plugin>
    <link name="link">
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.000013</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000013</iyy><iyz>0</iyz>
          <izz>0.000013</izz>
        </inertia>
      </inertial>
      <sensor name="box_contacts" type="contact">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <contact><collision>col</collision></contact>
      </sensor>
      <collision name="col">
        <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="vis">
        <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
        <material>
          <ambient>0.9 0.1 0.1 1</ambient>
          <diffuse>0.9 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
