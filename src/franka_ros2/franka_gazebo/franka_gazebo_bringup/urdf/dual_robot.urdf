    </actuator>
  </transmission>
  <gazebo reference="right_fr3v2_leftfinger">
    <collision>
      <max_contacts>10</max_contacts>
      <surface>
        <contact>
          <ode>
            <!-- These two parameter need application specific tuning. -->
            <!-- Usually you want no "snap out" velocity and a generous -->
            <!-- penetration depth to keep the grasping stable -->
            <max_vel>0</max_vel>
            <min_depth>0.001</min_depth>
          </ode>
        </contact>
        <friction>
          <ode>
            <mu>1.13</mu>
            <mu2>1.13</mu2>
          </ode>
        </friction>
        <bounce/>
      </surface>
    </collision>
  </gazebo>
  <gazebo reference="right_fr3v2_rightfinger">
